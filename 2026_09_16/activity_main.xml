<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Urzadzenia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Urzadzenia" />

    <TextView
        android:id="@+id/Autor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Autor" />

    <TextView
        android:id="@+id/Pralka"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Pralka" />

    <Button
        android:id="@+id/Zatwierdz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Zatwierdz" />

    <TextView
        android:id="@+id/Numer_prania"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Numer_prania" />

    <TextView
        android:id="@+id/Odkurzacz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Odkurzacz" />

    <Button
        android:id="@+id/Wlacz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Wlacz" />

    <TextView
        android:id="@+id/Odkurzacz_wylaczony"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Odkurzacz_wylaczony" />

    <TextView
        android:id="@+id/Odkurzacz_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Odkurzacz_status" />


</LinearLayout>